#!/usr/bin/env bash
# qa-stub — the stub backend tool. State lives in $QA_STUB_DIR.
#   create                      print a new question id
#   answer <id> human|judge <text>
#   answered <id>               exit 0 when any answer exists
#   answer-path <id>            print the winning answer file (human first)
set -euo pipefail
s="${QA_STUB_DIR:?QA_STUB_DIR not set}"; mkdir -p "$s"
case "$1" in
  create) n=$(( $(cat "$s/next" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$s/next"; echo "Q$n" ;;
  answer) printf '%s\n' "$4" > "$s/$2.$3" ;;
  answered) [ -e "$s/$2.human" ] || [ -e "$s/$2.judge" ] ;;
  answer-path)
    if [ -e "$s/$2.human" ]; then echo "$s/$2.human"
    elif [ -e "$s/$2.judge" ]; then echo "$s/$2.judge"
    else echo "no answer for $2" >&2; exit 1; fi ;;
  *) echo "usage: qa-stub create|answer|answered|answer-path" >&2; exit 2 ;;
esac
