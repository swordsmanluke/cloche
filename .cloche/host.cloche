workflow main {
  host {
    agent_command = "claude"
  }

  step prepare-prompt {
    run     = "bash .cloche/scripts/prepare-prompt.sh"
    results = [success, fail]
  }

  step develop {
    workflow_name = "develop"
    timeout       = "90m"
    results       = [success, fail]
  }

  step merge {
    run     = "bash .cloche/scripts/merge-to-base.sh"
    results = [success, fail]
  }

  step fix-merge-conflict {
    prompt  = file(".cloche/prompts/fix-merge-conflict.md")
    timeout = "30m"
    results = [success, fail]
  }

  step bump-version {
    run     = "new_ver=$(bumpver) && git add internal/version/VERSION && git commit -m \"Version $new_ver\""
    results = [success, fail]
  }

  step close-task {
    workflow_name = "close-task"
    results       = [success, fail]
  }

  step cleanup {
    run     = "bash .cloche/scripts/cleanup-run.sh"
    results = [success, fail]
  }

  prepare-prompt:success -> develop
  prepare-prompt:fail    -> abort
  develop:success        -> merge
  develop:fail           -> abort
  merge:success                -> bump-version
  merge:fail                   -> fix-merge-conflict
  fix-merge-conflict:success   -> bump-version
  fix-merge-conflict:fail      -> abort
  bump-version:success   -> close-task
  bump-version:fail      -> close-task
  close-task:success     -> cleanup
  close-task:fail        -> cleanup
  cleanup:success        -> done
  cleanup:fail           -> done
}

workflow changelog {
  host {
    agent_command = "claude"
  }

  step guard {
    run     = "bash .cloche/scripts/changelog-guard.sh"
    results = [success, fail]
  }

  step collect-commits {
    run     = "bash .cloche/scripts/changelog-collect-commits.sh"
    results = [success, fail]
  }

  step draft {
    prompt  = file(".cloche/prompts/draft-changelog.md")
    timeout = "15m"
    results = [success, fail]
  }

  step commit {
    run     = "bash .cloche/scripts/changelog-commit.sh"
    results = [success, fail]
  }

  guard:success           -> collect-commits
  guard:fail              -> abort
  collect-commits:success -> draft
  collect-commits:fail    -> abort
  draft:success           -> commit
  draft:fail              -> abort
  commit:success          -> done
  commit:fail             -> abort
}

workflow release {
  host {}

  step guard {
    run     = "bash .cloche/scripts/release-guard.sh"
    results = [success, fail]
  }

  step tag {
    run     = "bash .cloche/scripts/release-tag.sh"
    results = [success, fail]
  }

  step publish {
    run     = "bash .cloche/scripts/release-publish.sh"
    results = [success, skipped, fail]
  }

  guard:success   -> tag
  guard:fail      -> abort
  tag:success     -> publish
  tag:fail        -> abort
  publish:success -> done
  publish:skipped -> done
  publish:fail    -> abort
}

// check-main — run the full suite against main's HEAD on a timer and post an
// urgent ci-main/main-red signal when it is red. Start it once with
// `cloche run check-main`; it loops. The timer is the `wait` poll step comparing
// the clock with a target timestamp (no time trigger exists, CLOCHE-A114).
// CLOCHE_CHECK_MAIN_INTERVAL (seconds, default 21600) sets the period. Nothing
// pauses on red; it never auto-dispatches (see req-2e1d: only list-tasks, main
// and release-task do).
workflow check-main {
  host {
    agent_command = "claude"
  }

  step wait {
    poll     = "bash .cloche/scripts/check-main-wait.sh"
    interval = "1m"
    timeout  = "24h"
    results  = [due, timeout]
  }

  step changed {
    run     = "bash .cloche/scripts/check-main-changed.sh"
    results = [changed, unchanged, skip, fail]
  }

  step suite {
    workflow_name = "check-main-suite"
    results       = [success, fail]
  }

  step record-green {
    run     = "bash .cloche/scripts/check-main-record-green.sh"
    results = [success, fail]
  }

  step report-red {
    run     = "bash .cloche/scripts/check-main-report-red.sh"
    results = [success, fail]
  }

  step schedule {
    run     = "bash .cloche/scripts/check-main-schedule.sh"
    results = [success, fail]
  }

  wait:due           -> changed
  wait:timeout       -> changed
  changed:changed    -> suite
  changed:unchanged  -> schedule
  changed:skip       -> schedule
  changed:fail       -> abort
  suite:success      -> record-green
  suite:fail         -> report-red
  record-green:success -> schedule
  record-green:fail    -> abort
  report-red:success -> schedule
  report-red:fail    -> schedule
  schedule:success   -> wait
  schedule:fail      -> abort
}
