#!/usr/bin/env python3
"""Executable entry point Cloche invokes as `container.agent_command`.

Thin shim so `agent_command/` works straight from a git checkout with no
install step: put the harness root (this file's parent's parent) on
sys.path, then delegate to agent_command.cli.main. See ../README.md.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from agent_command.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
