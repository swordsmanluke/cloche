// See harness/arms/README.md for the rationale (kept out of this file on purpose).
workflow develop {
  container {
    id            = "haiku"
    agent_command = "claude"
    agent_args    = "-p --dangerously-skip-permissions --model claude-haiku-4-5-20251001"
  }

  step implement {
    prompt  = file(".cloche/prompts/implement.md")
    results = [success, fail]
  }

  step commit {
    run     = "git add -A && git commit -m \"implement task changes\" || true"
    results = [success, fail]
  }

  step test {
    run     = "python3 -m unittest discover -s tests -v"
    results = [success, fail]
  }

  step fix-tests {
    prompt       = file(".cloche/prompts/fix-tests.md")
    max_attempts = 2
    results      = [success, fail, give-up]
  }

  implement:success  -> commit
  implement:fail     -> commit
  commit:success     -> test
  commit:fail        -> abort
  test:success       -> done
  test:fail          -> fix-tests
  fix-tests:success  -> test
  fix-tests:fail     -> test
  fix-tests:give-up  -> abort
}
