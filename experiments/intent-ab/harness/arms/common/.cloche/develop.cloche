// Overlay (E5) on top of seed/.cloche/develop.cloche: identical wiring, plus
// the workflow-level container{} block that points every prompt step at the
// bonsai executor wrapper (E4) instead of the seed's default (Claude Code).
// This file is applied to BOTH arms — the executor is a controlled constant
// across arms (see the protocol doc's design table), not part of what the
// arm-specific overlays vary.
//
// The driver (arm_driver/overlay.py) copies harness/agent_command/ and
// harness/bin/ into each cloned project root before applying this overlay,
// so "bin/agent_command" resolves inside the container the same way it does
// for the harness's own fixture_check workflow (../../README.md).

workflow develop {
  // Workflow-level container{} config only accepts scalar values
  // (internal/dsl/parser.go's parseWorkflowConfig uses parseValue(), which
  // has no array support — unlike step-level container{} blocks, which do;
  // see parseStepField/parseStringList). agent_command is a scalar and
  // belongs once at workflow level; network_allow is an array, so it's
  // repeated on each prompt step's own container{} block below instead
  // (the same pattern E4's fixture_check workflow already uses).
  container {
    agent_command = "bin/agent_command"
  }

  step implement {
    prompt  = file(".cloche/prompts/implement.md")
    container {
      // host-gateway reachability to host.docker.internal is unconditional
      // (internal/adapters/docker/runtime.go); network_allow here documents
      // intent for when enforcement lands (docs/USAGE.md).
      network_allow = ["host.docker.internal:11434"]
    }
    results = [success, fail]
  }

  step commit {
    run     = "git add -A && git commit -m \"implement task changes\" || true"
    results = [success, fail]
  }

  step test {
    run     = "python3 -m unittest discover -s tests -v"
    results = [success, fail]
  }

  step fix-tests {
    prompt       = file(".cloche/prompts/fix-tests.md")
    max_attempts = 2
    container {
      network_allow = ["host.docker.internal:11434"]
    }
    results = [success, fail]
  }

  implement:success  -> commit
  implement:fail     -> abort
  commit:success     -> test
  commit:fail        -> abort
  test:success       -> done
  test:fail          -> fix-tests
  fix-tests:success  -> test
  fix-tests:fail     -> abort
}
