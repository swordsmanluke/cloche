#!/usr/bin/env python3
"""Fake `cloche` CLI for test_driver_integration.py -- covers exactly the
subcommands arm_driver.cloche_cli.Toolchain calls (init, loop [stop],
activity --json, status, intent preview, get). See ../fake_driver_lib.py
for the shared state machine and why this exists (no real daemon/Docker in
this sandbox)."""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from tests import fake_driver_lib as lib  # noqa: E402


def main(argv):
    if not argv:
        print("usage: cloche <command> [args...]", file=sys.stderr)
        return 1

    command = argv[0]

    if command == "init":
        return 0

    if command == "loop":
        return 0  # both `cloche loop` (start) and `cloche loop stop` are no-ops here

    if command == "activity":
        state = lib.load()
        for entry in state["activity"]:
            print(json.dumps(entry))
        return 0

    if command == "status":
        if len(argv) < 2:
            print("fake cloche: status requires a task id", file=sys.stderr)
            return 1
        state = lib.load()
        tokens = lib.token_count_for(state, argv[1])
        if tokens is None:
            return 1
        print(f"Tokens:  {tokens:,} (bonsai: {tokens:,})")
        return 0

    if command == "intent" and len(argv) >= 2 and argv[1] == "preview":
        print("## Standing project requirements\n\n- [req-aaaa] Fake requirement for the smoke test.")
        return 0

    if command == "get":
        if len(argv) < 2:
            return 1
        print("req-aaaa")
        return 0

    print(f"fake cloche: unsupported invocation: {argv}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
